@startuml
title Animal Rescue Management System — Class Diagram (current main)
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "com.rescue.model" {
  interface Entity {
    + getId() : int
  }
  class Animal {
    - id : int
    - name : String
    - species : String
    - ageYears : int
    - ageMonths : int
    - healthStatus : String
    - availableForAdoption : boolean
    - description : String
  }
  class Adopter {
    - id : int
    - name : String
    - email : String
    - phone : String
  }
  class Donor {
    - id : int
    - name : String
    - email : String
    - phone : String
  }
  class VolunteerOptions <<utility>> {
    {static} + SKILLS : List<String>
    {static} + AVAILABILITIES : List<String>
  }
  class Volunteer {
    - id : int
    - name : String
    - email : String
    - phone : String
    - skills : List<String>
    - availability : String
    - role : String
    - hours : double
    - certificates : List<String>
  }
  class RescueEvent {
    - id : int
    - name : String
    - type : String
    - date : LocalDate
    - location : String
    - requiredSkills : List<String>
    - hours : double
    - description : String
  }
  class EventRegistration {
    - id : int
    - eventId : int
    - volunteerId : int
    - status : String
    - registeredAt : LocalDateTime
  }
  class User {
    - id : int
    - username : String
    - password : String
    - role : String
  }

  interface Donation {
    + setId(id : int)
    + getAmount() : double
    + getReceiptText() : String
    + getDonor() : Donor
  }
  abstract class BaseDonation {
    - id : int
    - donor : Donor
    - amount : double
    - receiptText : String
  }
  class OnlineDonation
  class ChequeDonation
  class InKindDonation
  abstract class DonationDecorator {
    # donation : Donation
  }
  class RecurringDonation
  class InMemoryOfDonation {
    - personName : String
  }

  interface Recipient
  class Contact {
    - name : String
    - email : String
    - phone : String
    + PUBLIC_AUDIENCE : Contact
  }
  enum RecipientType
  enum ChannelType
  class SentMessage
  class ActivityFeed
  class AppConfig <<Singleton>> {
    - instance : AppConfig
    - orgName : String
    - contactEmail : String
    + getInstance() : AppConfig
  }
  class DataStore <<Singleton>> {
    - instance : DataStore
    - animals : Map
    - adopters : Map
    - donations : Map
    - donors : Map
    - volunteers : Map
    - events : Map
    - eventRegistrations : Map
    - users : Map
    - sentMessages : Map
    + getInstance() : DataStore
  }
}
Entity <|.. Animal
Entity <|.. Adopter
Entity <|.. Donor
Entity <|.. Volunteer
Entity <|.. RescueEvent
Entity <|.. EventRegistration
Entity <|.. User
Entity <|-- Donation
Donation <|.. BaseDonation
