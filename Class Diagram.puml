package "com.rescue.repo" {
  interface Repository<T extends Entity> {
    + save(item : T)
    + findById(id : int) : Optional<T>
    + findAll() : List<T>
    + delete(id : int)
  }
  class LookupTable<T extends Entity> {
    # items : Map<Integer,T>
    + nextId() : int
  }
  class AnimalRepository
  class AdopterRepository
  class VolunteerRepository
  class RescueEventRepository
  class EventRegistrationRepository
  class UserRepository
  class DonationRepository
  class DonorRepository
  class SentMessageRepository
}
Repository <|.. LookupTable
LookupTable <|-- AnimalRepository
LookupTable <|-- AdopterRepository
LookupTable <|-- VolunteerRepository
LookupTable <|-- RescueEventRepository
LookupTable <|-- EventRegistrationRepository
LookupTable <|-- UserRepository
Repository <|.. DonationRepository
Repository <|.. DonorRepository
Repository <|.. SentMessageRepository
