package "com.rescue.factory" {
  class DonationFactory {
    {static} + createDonation(type : String, donor : Donor, amount : double, receiptText : String) : Donation
  }
}
DonationFactory ..> Donation : creates
DonationFactory ..> OnlineDonation
DonationFactory ..> ChequeDonation
DonationFactory ..> InKindDonation

package "com.rescue.service" {
  interface NotificationStrategy
  interface Observer<E> {
    + update(event : E)
  }
  class Subject<E> {
    - observers : List<Observer<E>>
    + attach(observer : Observer<E>)
    + detach(observer : Observer<E>)
    + publish(event : E)
  }
  class CommunicationModule {
    - notifier : Notifier
    - feed : ActivityFeed
    - coordinator : Recipient
    - currency : String
    + connectDonations(donations : Subject<Donation>)
    + connectAnimals(animals : Subject<AnimalStatusChanged>)
    + connectEvents(events : Subject<EventUpdated>)
    + createController() : CommunicationController
  }
}
NotificationStrategy <|.. ChannelStrategy
Subject o-- Observer : notifies
CommunicationModule ..> Subject : exposes connect* hooks
CommunicationModule o-- Notifier
CommunicationModule o-- ActivityFeed
CommunicationModule ..> CommunicationController

package "com.rescue.service.strategy" {
  interface VolunteerMatchingStrategy {
    + getName() : String
    + match(volunteers : List<Volunteer>, criterion : String) : List<Volunteer>
  }
  abstract class ChannelStrategy {
    + getChannel() : ChannelType
    + canReach(recipient : Recipient) : boolean
    + addressOf(recipient : Recipient) : String
    + format(recipient : Recipient, message : String) : String
    + deliver(recipient : Recipient, message : String) : String
  }
  class EmailStrategy
  class SmsStrategy
  class SocialPostStrategy
  class SkillMatchingStrategy
  class AvailabilityMatchingStrategy
  class Notifier {
    - strategies : Map<ChannelType,ChannelStrategy>
    - defaultChannels : Map<RecipientType,ChannelType>
    - messageLog : Repository<SentMessage>
    + register(strategy : ChannelStrategy) : Notifier
    + send(recipient : Recipient, type : RecipientType, message : String) : SentMessage
    + history() : List<SentMessage>
  }
  interface MessageGateway
  class ConsoleGateway
}
ChannelStrategy <|-- EmailStrategy
ChannelStrategy <|-- SmsStrategy
ChannelStrategy <|-- SocialPostStrategy
VolunteerMatchingStrategy <|.. SkillMatchingStrategy
VolunteerMatchingStrategy <|.. AvailabilityMatchingStrategy
VolunteerMatchingStrategy ..> Volunteer : matches
Notifier o-- ChannelStrategy
ChannelStrategy ..> MessageGateway
MessageGateway <|.. ConsoleGateway
Notifier ..> Repository

